#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/games
. "$SCRIPT_DIR/lib/games"

usage() {
    echo "Usage: launch-game <game-name>"
}

# shellcheck disable=SC2329 # Invoked by the EXIT trap after a successful mount.
cleanup() {
    if [[ -z "$mount_dir" ]]; then
        return
    fi

    while mountpoint -q "$mount_dir"; do
        if sudo umount "$mount_dir"; then
            continue
        fi

        echo "Failed to unmount: $mount_dir" >&2

        return 1
    done
}

mount_user_pids() {
    sudo fuser -m "$mount_dir" 2>/dev/null
}

mount_has_users() {
    [[ -n "$(mount_user_pids)" ]]
}

wait_for_mount_users() {
    # Wait until process appears.
    for _ in {1..10}; do
        if mount_has_users; then
            break
        fi

        sleep 1
    done

    # Actual wait loop until user processes release the mount.
    while mount_has_users; do
        sleep 1
    done
}

prepare_overlay_dirs() {
    if mountpoint -q "$run_dir"; then
        if ! sudo umount "$run_dir"; then
            echo "Failed to unmount stale mount: $run_dir" >&2
            return 1
        fi
    fi

    mkdir -p "$work_dir" "$run_dir" "$upper_dir" "$mount_dir" "$logs_dir"

    if sudo getfattr -n trusted.overlay.origin "$upper_dir" >/dev/null 2>&1; then
        sudo setfattr -x trusted.overlay.origin "$upper_dir" || return 1
    fi
}

if (($# != 1)); then
    usage >&2
    exit 1
fi

game=$(resolve_game "$1")

if [[ -z "$game" ]]; then
    echo "Unknown game: $1" >&2
    exit 1
fi

root="$PWD/games/$game"

merged_dir="$root/merged"
upper_dir="$root/sink"
work_dir="$root/work"
run_dir="$root/run"
logs_dir="$root/logs"
mount_dir="$run_dir"
dll_overrides="winmm,version=n,b"

case "$game" in
    "Cyberpunk 2077")
        install_dir="$HOME/.steam/steam/steamapps/common/Cyberpunk 2077"
        compatdata_dir="$HOME/.steam/steam/steamapps/compatdata/1091500"
        game_executable="$run_dir/bin/x64/Cyberpunk2077.exe"
        ;;
    "Skyrim Special Edition")
        install_dir="$HOME/.steam/steam/steamapps/common/Skyrim Special Edition"
        compatdata_dir="$HOME/.steam/steam/steamapps/compatdata/489830"
        game_executable="$run_dir/skse64_loader.exe"

        if [[ -e "$merged_dir/d3dx9_42.dll" ]]; then
            dll_overrides="winmm,version,d3dx9_42=n,b"
        fi
        ;;
    "Minecraft")
        install_dir="$HOME/.minecraft"
        minecraft_home_dir="$run_dir"
        mount_dir="$minecraft_home_dir/.minecraft"
        game_executable="minecraft-launcher"
        ;;
    *)
        echo "Launching is not supported for $game" >&2
        exit 1
        ;;
esac

if [[ ! -d "$install_dir" ]]; then
    echo "Install directory does not exist: $install_dir" >&2
    exit 1
fi

sudo -v || exit 1

prepare_overlay_dirs || exit 1

log_file="$logs_dir/$(date +%Y%m%d-%H%M%S).log"

sudo mount -t overlay overlay \
    -o index=off -o metacopy=off -o "lowerdir=$merged_dir:$install_dir,upperdir=$upper_dir,workdir=$work_dir" \
    "$mount_dir" || exit 1

trap cleanup EXIT

if [[ "$game" == "Minecraft" ]]; then
    # shellcheck disable=SC2016 # Expanded by the child shell after positional args are assigned.
    gum spin --title "Launching $game" -- \
        bash -c 'log_file=$1; minecraft_home_dir=$2; game_executable=$3; HOME="$minecraft_home_dir" "$game_executable" >"$log_file" 2>&1' \
        bash "$log_file" "$minecraft_home_dir" "$game_executable"
    launcher_status=$?

    wait_for_mount_users

    exit "$launcher_status"
else
    # shellcheck disable=SC2016 # Expanded by the child shell after positional args are assigned.
    gum spin --title "Launching $game" -- \
        bash -c 'log_file=$1; mount_dir=$2; shift 2; cd "$mount_dir" || exit; "$@" >"$log_file" 2>&1' \
        bash "$log_file" "$mount_dir" \
        env \
        "STEAM_COMPAT_CLIENT_INSTALL_PATH=$HOME/.steam/steam" \
        "STEAM_COMPAT_DATA_PATH=$compatdata_dir" \
        "WINEDLLOVERRIDES=$dll_overrides" \
        "$HOME/.steam/steam/steamapps/common/Proton - Experimental/proton" \
        waitforexitandrun "$game_executable"
    proton_status=$?

    wait_for_mount_users

    exit "$proton_status"
fi
